REDIS_URL=redis://127.0.0.1:6379
# Where designer saves put the baked map surface images (served by the
# asset-storage nginx at <assetStorageBaseUrl>/map-assets/<mapId>/<file>;
# this server never serves files itself). Two modes:
#  - a directory: the asset-storage checkout's assets/map-assets folder on
#    THIS machine (dev loop). Defaults to ./map-assets when unset.
#  - an http(s) URL: the asset server origin (prod / dockerized server, where
#    the asset host is another machine). Files are PUT through its
#    /api/upload/ sidecar, which needs the shared ASSET_UPLOAD_TOKEN below —
#    without it designer saves fall back to embedding the tiles in map data.
ASSET_STORAGE_URL=../asset-storage/assets/map-assets
# Optional: upload origin when it differs from ASSET_STORAGE_URL.
ASSET_UPLOAD_URL=
# Shared secret of the asset-storage upload sidecar (asset-storage/.env).
ASSET_UPLOAD_TOKEN=
JWT_SECRET=change-me
AUTH_PEPPER=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_EMAIL_VALIDATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

APP_PUBLIC_URL=http://localhost:3000
EMAIL_VALIDATION_PATH=/#/validate-email
PASSWORD_RESET_PATH=/#/recover-password

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# --- pokecraft-api (authoritative data store) -------------------------------
# Base URL of the Quarkus API and the admin-scoped API key this server uses to
# manage keys on behalf of admins. The admin key must match a key with `admin`
# scope in pokecraft-api (or its bootstrap POKECRAFT_AUTH_ADMIN_KEY). Keep it
# server-side only — the browser never sees it.
POKECRAFT_API_URL=http://localhost:8080
POKECRAFT_API_ADMIN_KEY=

# --- Berry plots ------------------------------------------------------------
# Multiplier on the real-time growth clock of the global berry plots
# (PBS berryplants.txt hours per stage). 1 = real hours. Dev/E2E only:
# 0.001 turns a 3-hour stage into ~11 seconds.
BERRY_GROWTH_SCALE=1

# House pets (components/HousePets.ts). Test knobs only — leave unset in prod.
# PET_TIME_SCALE multiplies how fast pets get hungry/bored/mate (1 = real time);
# PET_SLOW_TICK_MS is the life-tick interval (default 30000).
# PET_TIME_SCALE=1
# PET_SLOW_TICK_MS=30000
