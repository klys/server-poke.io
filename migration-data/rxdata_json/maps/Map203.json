_class":"RPG::EventCommand","code":203,"indent":0,"parameters":[2,3,4]},{"__class":"RPG::EventCommand","code":207,"indent":0,"parameters":[0,4]},{"__class":"RPG::EventCommand","code":209,"indent":0,"parameters":[0,{"__class":"RPG::MoveRoute","list":[{"__class":"RPG::MoveCommand","code":16,"parameters":[]},{"__class":"RPG::MoveCommand","code":1,"parameters":[]},{"__class":"RPG::MoveCommand","code":1,"parameters":[]},{"__class":"RPG::MoveCommand","code":1,"parameters":[]},{"__class":"RPG::MoveCommand","code":1,"parameters":[]},{"__class":"RPG::MoveCommand","code":35,"parameters":[]},{"__class":"RPG::MoveCommand","code":0,"parameters":[]}],"repeat":false,"skippable":false}]},{"__class":"RPG::EventCommand","code":509,"indent":0,"parameters":[{"__ref":"RPG::MoveCommand:3486120","__class":"RPG::MoveCommand"}]},{"__class":"RPG::EventCommand","code":509,"indent":0,"parameters":[{"__ref":"RPG::MoveCommand:3486160","__class":"RPG::MoveCommand"}]},{"__class":"RPG::EventCommand","code":509,"indent":0,"parameters":[{"__ref":"RPG::MoveCommand:3486200","__class":"RPG::MoveCommand"}]},{"__class":"RPG::EventCommand","code":509,"indent":0,"parameters":[{"__ref":"RPG::MoveCommand:3486240","__class":"RPG::MoveCommand"}]},{"__class":"RPG::EventCommand","code":509,"indent":0,"parameters":[{"__ref":"RPG::MoveCommand:3486280","__class":"RPG::MoveCommand"}]},{"__class":"RPG::EventCommand","code":509,"indent":0,"parameters":[{"__ref":"RPG::MoveCommand:3486320","__class":"RPG::MoveCommand"}]},{"__class":"RPG::EventCommand","code":207,"indent":0,"parameters":[0,3]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bAhhh, Soy José Gregorio ¿quién eres? ¿Mi hermano te envió a buscarme?"]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: Ahhhhhhh pase la noche acá, ayer mi hermano y yo estábamos entrenando"]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: Y pasó algo horrible, mi equipo está debilitado, no tengo arepas, ni nada; por eso no he podido regresar a Ciudad Fortuna, aparte afuera hay entrenadores muy fuertes"]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: Anoche mientras entrenaba con mi hermano en la zona oscura del mar, sentimos unas presencias extrañas"]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: De repente hubo una explosión que mando a volar a mi hermano, lo divisé a lo lejos flotando en el mar, también había una sombra, estaba frente a él, llorando… Cuando quiero ir hacia donde está…."]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: Siento que algo está atrás de mí."]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: Volteo y veo un Toniptera macho, por lo azulado... Pero no era normal, sus ojos eran rojos y brotaban lagrimas llenas de dolor…"]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: Supe que algo malo iba a suceder, como pude con mi equipo aguanté los ataques, pero a ello se unió la otra sombra, una Toniptera hembra igual de tenebrosa, inevitablemente fui derrotado y enviado por una gran ola a la isla."]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio: Casi inconsciente vi como esos Tonipteras se hundían en el mar, también pude ver como el quipo de mi hermano se lo llevaban"]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\\bJosé Gregorio:seguro lo dejaron en Ciudad Fortuna antes de caer debilitados. Es un milagro que siga con vida, es probable que anden en el fondo marino, siento que algo hay con ese barco hundido, tengo miedo."]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["...."]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["\"José Gregorio se desmaya\""]},{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["(Parece que tocará investigar solo...)"]},{"__class":"RPG::EventCommand","code":123,"indent":0,"parameters":["A",0]},{"__class":"RPG::EventCommand","code":121,"indent":0,"parameters":[160,160,0]},{"__class":"RPG::EventCommand","code":0,"indent":0,"parameters":[]}],"move_frequency":3,"move_route":{"__class":"RPG::MoveRoute","list":[{"__class":"RPG::MoveCommand","code":0,"parameters":[]}],"repeat":true,"skippable":false},"move_speed":3,"move_type":0,"step_anime":false,"through":false,"trigger":3,"walk_anime":true},{"__class":"RPG::Event::Page","always_on_top":false,"condition":{"__class":"RPG::Event::Page::Condition","self_switch_ch":"A","self_switch_valid":true,"switch1_id":1,"switch1_valid":false,"switch2_id":1,"switch2_valid":false,"variable_id":1,"variable_valid":false,"variable_value":0},"direction_fix":true,"graphic":{"__class":"RPG::Event::Page::Graphic","blend_type":0,"character_hue":0,"character_name":"trchar93","direction":2,"opacity":255,"pattern":0,"tile_id":0},"list":[{"__class":"RPG::EventCommand","code":101,"indent":0,"parameters":["(¿Estará muerto?) Quizás si le pico los ojos con una rama..."]},{"__class":"RPG::EventCommand","code":0,"indent":0,"parameters":[]}],"move_frequency":3,"move_route":{"__class":"RPG::MoveRoute","list":[{"__class":"RPG::MoveCommand","code":0,"parameters":[]}],"repeat":true,"skippable":false},"move_speed":3,"move_type":0,"step_anime":false,"through":false,"trigger":0,"walk_anime":false},{"__class":"RPG::Event::Page","always_on_top":false,"condition":{"__class":"RPG::Event::Page::Condition","self_switch_ch":"A","self_switch_valid":false,"switch1_id":165,"switch1_valid":true,"switch2_id":1,"switch2_valid":false,"variable_id":1,"variable_valid":false,"variable_value":0},"direction_fix":false,"graphic":{"__class":"RPG::Event::Page::Graphic","blend_type":0,"character_hue":0,"character_name":"","direction":2,"opacity":255,"pattern":0,"tile_id":0},"list":[{"__class":"RPG::EventCommand","code":0,"indent":0,"parameters":[]}],"move_frequency":3,"mo